APP_NAME="Stimergie Image Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=stimergie_image_hub
DB_USERNAME=stimergie
DB_PASSWORD=stimergie

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=scaleway
IMAGE_STORAGE_DISK=scaleway
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_IMAGE_TAG_MODEL=gpt-4.1-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fr-par
AWS_BUCKET=stimergie
AWS_ENDPOINT=https://s3.fr-par.scw.cloud
AWS_USE_PATH_STYLE_ENDPOINT=false

SCALEWAY_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
SCALEWAY_SECRET_KEY="${AWS_SECRET_ACCESS_KEY}"
SCALEWAY_OBJECT_STORAGE_BUCKET="${AWS_BUCKET}"
SCALEWAY_OBJECT_STORAGE_REGION="${AWS_DEFAULT_REGION}"
SCALEWAY_OBJECT_STORAGE_ENDPOINT="${AWS_ENDPOINT}"
SCALEWAY_OBJECT_STORAGE_URL=

VITE_APP_NAME="${APP_NAME}"
