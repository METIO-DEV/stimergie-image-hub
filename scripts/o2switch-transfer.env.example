# Copy this file to scripts/o2switch-transfer.env.
# Do not commit the real env file.

RCLONE_BIN=rclone

# ftp: run from your local machine and read files from o2switch FTP.
# local: run from o2switch server and read SOURCE_DIR directly.
SOURCE_TYPE=ftp
SOURCE_REMOTE=o2switch
SOURCE_DIR=/collabspace.veni6445.odns.fr/photos

FTP_HOST=109.234.166.71
FTP_PORT=21
FTP_USER=veni6445
FTP_PASSWORD=replace_me
FTP_EXPLICIT_TLS=true
FTP_NO_CHECK_CERTIFICATE=true

SCALEWAY_ACCESS_KEY_ID=replace_me
SCALEWAY_SECRET_KEY=replace_me
SCALEWAY_BUCKET=replace_me
SCALEWAY_REGION=fr-par
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud

# Bucket path final. Keep this stable so rclone can skip files already present.
DEST_PREFIX=photos

# check: estimate/list only
# list-dirs: print selected source folders
# dry-run: simulate copy
# copy: transfer
# sync: replace destination with source. Requires ALLOW_SYNC_DELETE=true.
# batch-dry-run: simulate selected folders
# batch-copy: transfer selected folders
# batch-sync: replace selected destination folders with source. Requires ALLOW_SYNC_DELETE=true.
# batch-verify: verify selected folders against bucket
MODE=dry-run

# Optional: transfer one folder first, e.g. ADAMANCE_190224
LIMIT_PATH=

# Batch selection. With BATCH_SIZE=10 and BATCH_OFFSET=0, the script selects
# the first 10 source folders alphabetically. Set BATCH_OFFSET=10 for the next
# 10, BATCH_OFFSET=20 for the next 10, etc.
BATCH_SIZE=10
BATCH_OFFSET=0

# Optional: explicit list of folders, one per line. Takes priority over
# BATCH_SIZE/BATCH_OFFSET when set.
BATCH_FILE=

# Runs rclone check after each copied folder in batch-copy mode.
VERIFY_AFTER_COPY=true

# Dangerous: rclone sync deletes destination files absent from source.
ALLOW_SYNC_DELETE=false

# Optional: stop after N GB, e.g. 5
MAX_TRANSFER_GB=

TRANSFERS=6
CHECKERS=12
S3_ACL=public-read
LOG_FILE=./scripts/rclone-transfer.log
